# Copie para .env.local e coloque UMA das chaves abaixo.
# Sem chave, o sistema roda em "modo demonstração" (monta o currículo só com os dados do perfil).

# Google Gemini (tem plano gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo do Gemini
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (pago). Só é usada se GEMINI_API_KEY estiver vazia.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Candidatura automática (1 = ligada): vagas novas do vagas-bot ganham currículo e são enviadas
# sozinhas pelo candidatar.py. LinkedIn e Gupy ficam de fora. Precisa do candidatar.py rodando.
AUTO_CANDIDATAR=0
# Opcional: de quantos em quantos minutos procura vagas novas
AUTO_INTERVALO_MIN=30
